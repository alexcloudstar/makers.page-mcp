# Copy this file to .env and fill in your values.
# Bun loads .env automatically, no extra setup needed.

# From the X developer portal (OAuth 2.0 settings on your app).
X_CLIENT_ID=
# Only needed if your X app is a confidential client (has a Client Secret).
X_CLIENT_SECRET=
# Must exactly match the callback URL registered in the X developer portal.
X_REDIRECT_URI=http://127.0.0.1:8879/callback

# Optional overrides, defaults shown below.
# MAKERS_PAGE_CONFIG_DIR=~/.config/makers-page-mcp
# MAKERS_PAGE_DATA_DIR=~/.local/share/makers-page-mcp
# MAKERS_PAGE_REQUIRE_APPROVAL=true
# MAKERS_PAGE_MAX_POST_LENGTH=280
