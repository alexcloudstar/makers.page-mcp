{
  "name": "makers-page-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.alexcloudstar/makers-page-mcp",
  "description": "Makers Page MCP: the indie stack MCP — one local server for socials, payments, analytics, GitHub, and DBs. X publish ships first.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "makers-page",
    "indie-stack",
    "x",
    "twitter",
    "social-media",
    "stripe",
    "analytics",
    "ai-agent",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "author": "alexcloudstar",
  "homepage": "https://makers.page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcloudstar/makers.page-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alexcloudstar/makers.page-mcp/issues"
  },
  "type": "module",
  "bin": {
    "makers-page-mcp": "dist/index.js",
    "makers-page-mcp-auth": "dist/auth/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "bun dist/index.js",
    "auth": "bun dist/auth/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  }
}
